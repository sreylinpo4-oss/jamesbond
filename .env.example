# Supabase Public Configuration
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public HTTPS origin used for OAuth redirects and payment callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credentials. Never expose these as NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=your-payway-merchant-id
PAYWAY_API_KEY=your-payway-api-key
CRON_SECRET=replace-with-a-long-random-secret
